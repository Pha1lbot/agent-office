# Keys for the free job-search feeds. Copy this file to ".env" in this folder and fill in the values.
# ".env" is never saved to GitHub (it is in .gitignore). Never paste these into chat or a commit.
#
# Reed: sign up free at https://www.reed.co.uk/developers/jobseeker, copy the API key.
REED_API_KEY=
# Adzuna: sign up free at https://developer.adzuna.com, copy the application id and key.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
